# ---- Database (Neon PostgreSQL) ----
# Pooled connection string used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/storepulse?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (non-pooled) connection string used by Prisma Migrate
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/storepulse?sslmode=require"

# ---- Shopify ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL="https://storepulse.vercel.app"
SHOPIFY_SCOPES="read_products,read_orders,read_inventory,read_customers,read_locations"
SHOPIFY_API_VERSION="2025-01"

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL="StorePulse <alerts@yourdomain.com>"

# ---- Cron / security ----
CRON_SECRET=
# 32+ char random string used to sign app sessions and OAuth state
APP_SESSION_SECRET=

# ---- Development ----
# Set to "true" to enable the demo store (sample data, no Shopify needed)
DEMO_MODE="false"
